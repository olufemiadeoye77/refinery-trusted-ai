flowchart TB
  subgraph L45["Enterprise / Cloud Governance (Purdue L4-L5)"]
    MR[Model Registry]
    RR[AI Risk Register]
    CE[Compliance Evidence Store]
    TR[Training Pipeline]
  end

  subgraph L35["OT DMZ - AI Advisory & Zero-Trust Enforcement (L3.5)"]
