%% Advisory sequence: end-to-end flow of one recommendation
sequenceDiagram
    autonumber
    participant TWIN as Digital Twin
    participant QA as Quality Agent
    participant EA as Energy Agent
    participant MA as Maintenance Agent
    participant ORCH as Orchestrator
    participant CA as Compliance Agent
    participant SIGN as Signing Service
    participant VER as Verifier
    participant OP as Operator
    participant MOC as MOC / Setpoint

    TWIN->>QA: process state (read-only)
    TWIN->>EA: process state (read-only)
    TWIN->>MA: process state (read-only)
    QA->>ORCH: proposal (unsigned)
    EA->>ORCH: proposal (unsigned)
    MA->>ORCH: proposal (unsigned)
    ORCH->>ORCH: rank + bounds-check
    ORCH->>CA: attest(proposal, model)
    CA-->>ORCH: evidence_ref
    ORCH->>SIGN: sign(envelope)
    SIGN-->>ORCH: signed envelope
    ORCH->>VER: verify(envelope)
    alt verification ok
        VER-->>ORCH: ok
        ORCH->>OP: ranked advisory + provenance + evidence_ref
        OP->>MOC: approve (human decision logged)
        MOC->>TWIN: apply setpoint via standard change path
    else verification fails
        VER-->>ORCH: reject (stage, reason)
        ORCH->>ORCH: log rejection
    end
